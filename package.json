{
  "name": "opspilot-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "OpsPilot — AI-Powered DevOps & SRE Incident Assistant",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "cd apps/api && .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8001 --reload",
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "test": "apps/api/.venv/bin/pytest tests/ -v",
    "test:api": "apps/api/.venv/bin/pytest tests/ -v"
  }
}

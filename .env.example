# OpsPilot Environment Configuration Example
# Copy to .env and configure as needed.

# ==========================================
# Backend API Configuration
# ==========================================
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Maximum allowed log size in characters (default: 65,536 = 64KB)
MAX_LOG_SIZE_CHARS=65536

# Database Persistence
# Default uses local SQLite file; can be swapped for PostgreSQL (e.g., in Docker Compose)
DATABASE_URL=sqlite:///./opspilot.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/opspilot

# ==========================================
# AI Provider Configuration
# ==========================================
# Options: "mock", "gemini", "openai"
AI_PROVIDER=mock

# Real AI Provider Credentials (Optional if AI_PROVIDER=mock)
# Never expose these keys to the frontend client!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
